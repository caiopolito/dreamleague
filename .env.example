# Copy this file to .env and fill in your values.
# The .env file is loaded automatically by docker-compose.

# ── Steam ────────────────────────────────────────────────────────────────────
# Get your Steam API key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ── Database passwords ────────────────────────────────────────────────────────
# Password for the MongoDB root user (used by database-matches and gameserver)
MONGO_ROOT_PASSWORD=your_mongo_password_here

# Password for the MSSQL SA account (used by database-main)
MSSQL_SA_PASSWORD=your_mssql_password_here

# ── API TLS certificate ───────────────────────────────────────────────────────
# Password for the Kestrel HTTPS certificate (.pfx) mounted at ~/.aspnet/https/
# Generate with: dotnet dev-certs https -ep ~/.aspnet/https/dockerapissl.pfx -p <password>
KESTREL_CERT_PASSWORD=your_cert_password_here
