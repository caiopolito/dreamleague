{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DreamLeague API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/dreamleague.api/api/src/dreamleague.api/bin/Debug/net6.0/dreamleague.api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/dreamleague.api/api/src/dreamleague.api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
