FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Match the env var names that cm2network/steamcmd exposed so Dockerfile
# and entrypoint.sh work without changes.
ENV USER=steam \
    HOMEDIR=/home/steam \
    STEAMCMDDIR=/home/steam/steamcmd

ENV STEAMAPPID=730 \
    STEAMAPP="cs2" \
    STEAMAPPDIR=/home/steam/cs2server \
    CSGOFOLDERDIR=/home/steam/cs2server/game/csgo

# i386 arch is required for the 32-bit steamcmd bootstrap binary
RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        lib32gcc-s1 \
        ca-certificates \
        wget \
        curl \
        libicu-dev \
        unzip \
        procps \
        lib32z1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create the steam user
RUN useradd -m -u 1000 -s /bin/bash "${USER}"

# Install SteamCMD
RUN mkdir -p "${STEAMCMDDIR}" \
    && wget -qO- 'https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz' \
       | tar xvzf - -C "${STEAMCMDDIR}" \
    && chown -R "${USER}:${USER}" "${HOMEDIR}"

# Download CS2 as the steam user (avoids steamcmd file permission errors)
USER ${USER}
RUN mkdir -p "${STEAMAPPDIR}" \
    && until bash "${STEAMCMDDIR}/steamcmd.sh" \
        +force_install_dir "${STEAMAPPDIR}" \
        +login anonymous \
        +app_update "${STEAMAPPID}" validate \
        +quit; do \
        echo "[steamcmd] Download interrupted (exit $?), retrying in 10s..."; \
        sleep 10; \
    done
